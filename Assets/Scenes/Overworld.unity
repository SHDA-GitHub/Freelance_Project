--- !u!114 &1749889610
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1749889609}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f91b691bc06f4641996f97a3286f2eb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  dialogueLines:
  - dialogueText: '"Why hello there, youngin!"'
    yesDialogueLines: []
    yesChoiceID: yes
    yesButtonText: Yes
    noDialogueLines: []
    noChoiceID: no
    noButtonText: No
    isChoiceActive: 0
  - dialogueText: '"Are you looking for something?"'
    yesDialogueLines:
    - dialogueText: '"Wha? What''s that, sonny?"'
      yesDialogueLines: []
      yesChoiceID: yes
      yesButtonText: 
      noDialogueLines: []
      noChoiceID: no
      noButtonText: 
      isChoiceActive: 0
    - dialogueText: '"You''re going on a journey to stop an evil alien overlord from
        destroying the earth?"'
      yesDialogueLines: []
      yesChoiceID: yes
      yesButtonText: 
      noDialogueLines: []
      noChoiceID: no
      noButtonText: 
      isChoiceActive: 0
    - dialogueText: '"Heh, kids these days with their wild imaginations!"'
      yesDialogueLines: []
      yesChoiceID: yes
      yesButtonText: 
      noDialogueLines: []
      noChoiceID: no
      noButtonText: 
      isChoiceActive: 0
    - dialogueText: '"Well, you have fun out there, kiddo!"'
      yesDialogueLines: []
      yesChoiceID: yes
      yesButtonText: 
      noDialogueLines: []
      noChoiceID: no
      noButtonText: 
      isChoiceActive: 0
    yesChoiceID: yes
    yesButtonText: Tell him the truth
    noDialogueLines:
    - dialogueText: '"Wha? What''s that, sonny?"'
      yesDialogueLines: []
      yesChoiceID: yes
      yesButtonText: 
      noDialogueLines: []
      noChoiceID: no
      noButtonText: 
      isChoiceActive: 0
    - dialogueText: '"I don''t take too kindly to that type of language!"'
      yesDialogueLines: []
      yesChoiceID: yes
      yesButtonText: 
      noDialogueLines: []
      noChoiceID: no
      noButtonText: 
      isChoiceActive: 0
    - dialogueText: '"I may be old, but I''m not stupid!"'
      yesDialogueLines: []
      yesChoiceID: yes
      yesButtonText: 
      noDialogueLines: []
      noChoiceID: no
      noButtonText: 
      isChoiceActive: 0
    - dialogueText: '"Err... What was I talking about again?"'
      yesDialogueLines: []
      yesChoiceID: yes
      yesButtonText: 
      noDialogueLines: []
      noChoiceID: no
      noButtonText: 
      isChoiceActive: 0
    noChoiceID: no
    noButtonText: Be a big stinky meanie
    isChoiceActive: 1
  dialogueMusic: {fileID: 8300000, guid: 79bdb85db6ed0304baa917f531b76b57, type: 3}

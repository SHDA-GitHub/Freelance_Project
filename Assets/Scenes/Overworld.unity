--- !u!114 &1089145198
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1089145196}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f91b691bc06f4641996f97a3286f2eb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  dialogueLines:
  - dialogueText: '"Woah there, kid!"'
    yesDialogueLines: []
    yesButtonText: 
    noDialogueLines: []
    noButtonText: 
    isChoiceActive: 0
  - dialogueText: '"Easy on the personal space. I''m trying to look good"'
    yesDialogueLines: []
    yesButtonText: 
    noDialogueLines: []
    noButtonText: 
    isChoiceActive: 0
  - dialogueText: '"And you''re emanating an aura of ugliness that makes me look
      worse."'
    yesDialogueLines: []
    yesButtonText: 
    noDialogueLines: []
    noButtonText: 
    isChoiceActive: 0
  - dialogueText: '"You get me?"'
    yesDialogueLines:
    - dialogueText: '"I''m sorry, what was that?"'
      yesDialogueLines:
      - dialogueText: '"Oh, so you want to pick a fight, huh?"'
        yesDialogueLines: []
        yesButtonText: 
        noDialogueLines: []
        noButtonText: 
        isChoiceActive: 0
      - dialogueText: '"You''re asking for it!"'
        yesDialogueLines: []
        yesButtonText: 
        noDialogueLines: []
        noButtonText: 
        isChoiceActive: 0
      yesButtonText: I said I'm gonna punch the veneers out your mouth.
      noDialogueLines:
      - dialogueText: '"That''s what I thought"'
        yesDialogueLines: []
        yesButtonText: 
        noDialogueLines: []
        noButtonText: 
        isChoiceActive: 0
      noButtonText: Nothing!
      isChoiceActive: 1
    yesButtonText: What a punchable face you have.
    noDialogueLines:
    - dialogueText: '"That''s alright. Not everyone can be as beautiful as me, anyways."'
      yesDialogueLines: []
      yesButtonText: 
      noDialogueLines: []
      noButtonText: 
      isChoiceActive: 0
    - dialogueText: '"Don''t take it to heart, you''re just very, very, VERY hideous-looking."'
      yesDialogueLines: []
      yesButtonText: 
      noDialogueLines: []
      noButtonText: 
      isChoiceActive: 0
    noButtonText: I understand. Sorry, sir.
    isChoiceActive: 1
  dialogueMusic: {fileID: 8300000, guid: 79633e99eb886a94393f0996a68cc8ee, type: 3}

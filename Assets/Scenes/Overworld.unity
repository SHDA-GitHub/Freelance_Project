  m_Script: {fileID: 11500000, guid: 2f91b691bc06f4641996f97a3286f2eb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  dialogueLines:
  - dialogueText: '"Why hello there, dearie..."'
    yesDialogueLines: []
    yesButtonText: 
    noDialogueLines: []
    noButtonText: 
    isChoiceActive: 0
  - dialogueText: '"Could you help find something for me?"'
    yesDialogueLines: []
    yesButtonText: 
    noDialogueLines: []
    noButtonText: 
    isChoiceActive: 0
  - dialogueText: '"I''m afraid I''ve lost it and I cannot find it on my own..."'
    yesDialogueLines:
    - dialogueText: '"You''re such a kindhearted young man!"'
      yesDialogueLines: []
      yesButtonText: 
      noDialogueLines: []
      noButtonText: 
      isChoiceActive: 0
    - dialogueText: '"Anywho, I''ve lost my mirror..."'
      yesDialogueLines: []
      yesButtonText: 
      noDialogueLines: []
      noButtonText: 
      isChoiceActive: 0
    - dialogueText: '"I always have it with me, but for some reason I cannot find
        it anymore."'
      yesDialogueLines: []
      yesButtonText: 
      noDialogueLines: []
      noButtonText: 
      isChoiceActive: 0
    - dialogueText: '"Please, find it and return it to me."'
      yesDialogueLines: []
      yesButtonText: 
      noDialogueLines: []
      noButtonText: 
      isChoiceActive: 0
    yesButtonText: Sure thing!
    noDialogueLines:
    - dialogueText: '"How heartless and cruel..."'
      yesDialogueLines: []
      yesButtonText: 
      noDialogueLines: []
      noButtonText: 
      isChoiceActive: 0
    noButtonText: Go get it yourself granny
    isChoiceActive: 1
  dialogueMusic: {fileID: 8300000, guid: 3e1908685854ac14e8904008ea2d83e6, type: 3}

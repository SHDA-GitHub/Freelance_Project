MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 729050405}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f91b691bc06f4641996f97a3286f2eb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  dialogueLines:
  - dialogueText: '"Hello there, kind fella!"'
    yesDialogueLines: []
    yesChoiceID: yes
    yesButtonText: 
    noDialogueLines: []
    noChoiceID: no
    noButtonText: 
    isChoiceActive: 0
  - dialogueText: '"The name''s Cheerful Chester!"'
    yesDialogueLines: []
    yesChoiceID: yes
    yesButtonText: 
    noDialogueLines: []
    noChoiceID: no
    noButtonText: 
    isChoiceActive: 0
  - dialogueText: '"Isn''t this town so nice?"'
    yesDialogueLines: []
    yesChoiceID: yes
    yesButtonText: 
    noDialogueLines: []
    noChoiceID: no
    noButtonText: 
    isChoiceActive: 0
  - dialogueText: '"The serenity..."'
    yesDialogueLines: []
    yesChoiceID: yes
    yesButtonText: 
    noDialogueLines: []
    noChoiceID: no
    noButtonText: 
    isChoiceActive: 0
  - dialogueText: '"The peaceful greenery..."'
    yesDialogueLines: []
    yesChoiceID: yes
    yesButtonText: 
    noDialogueLines: []
    noChoiceID: no
    noButtonText: 
    isChoiceActive: 0
  - dialogueText: '"The birds chirping..."'
    yesDialogueLines: []
    yesChoiceID: yes
    yesButtonText: 
    noDialogueLines: []
    noChoiceID: no
    noButtonText: 
    isChoiceActive: 0
  - dialogueText: '"It''s just wonderful, right?"'
    yesDialogueLines:
    - dialogueText: '"Glad you think so too!"'
      yesDialogueLines: []
      yesChoiceID: yes
      yesButtonText: 
      noDialogueLines: []
      noChoiceID: no
      noButtonText: 
      isChoiceActive: 0
    yesChoiceID: yes
    yesButtonText: Yeah, it's nice
    noDialogueLines:
    - dialogueText: '"Oh. Well, agree to disagree!"'
      yesDialogueLines: []
      yesChoiceID: yes
      yesButtonText: 
      noDialogueLines: []
      noChoiceID: no
      noButtonText: 
      isChoiceActive: 0
    noChoiceID: no
    noButtonText: No, it sucks
    isChoiceActive: 1
  dialogueMusic: {fileID: 8300000, guid: d031c9a17dbde134f84e473879d6f20c, type: 3}

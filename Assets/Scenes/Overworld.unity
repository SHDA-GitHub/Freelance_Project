  m_Script: {fileID: 11500000, guid: 2f91b691bc06f4641996f97a3286f2eb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  dialogueLines:
  - dialogueText: '"Welcome to Slickster Sleazebag''s emporium."'
    yesDialogueLines: []
    yesChoiceID: yes
    yesButtonText: 
    noDialogueLines: []
    noChoiceID: no
    noButtonText: 
    isChoiceActive: 0
  - dialogueText: '"Whaddaya want?"'
    yesDialogueLines:
    - dialogueText: '"And what exactly are we looking for?"'
      yesDialogueLines:
      - dialogueText: '"Well, take a gander at some of my wares, then!"'
        yesDialogueLines: []
        yesChoiceID: yes
        yesButtonText: 
        noDialogueLines: []
        noChoiceID: no
        noButtonText: 
        isChoiceActive: 0
      yesChoiceID: wantToShop
      yesButtonText: To buy
      noDialogueLines:
      - dialogueText: '"Do I look like a damn thrift shop owner to you?"'
        yesDialogueLines: []
        yesChoiceID: yes
        yesButtonText: 
        noDialogueLines: []
        noChoiceID: no
        noButtonText: 
        isChoiceActive: 0
      - dialogueText: '"Take your garbage somewhere else!"

'
        yesDialogueLines: []
        yesChoiceID: yes
        yesButtonText: 
        noDialogueLines: []
        noChoiceID: no
        noButtonText: 
        isChoiceActive: 0
      noChoiceID: wantToSell
      noButtonText: To sell
      isChoiceActive: 1
    yesChoiceID: yes
    yesButtonText: 'I''m looking for something

'
    noDialogueLines:
    - dialogueText: '"Well then get the hell outta my store!"'
      yesDialogueLines: []
      yesChoiceID: yes
      yesButtonText: 
      noDialogueLines: []
      noChoiceID: no
      noButtonText: 
      isChoiceActive: 0
    - dialogueText: '"You''re takin'' up my precious business time, ya little runt!"'
      yesDialogueLines: []
      yesChoiceID: yes
      yesButtonText: 
      noDialogueLines: []
      noChoiceID: no
      noButtonText: 
      isChoiceActive: 0
    noChoiceID: no
    noButtonText: Nothing
    isChoiceActive: 1
  dialogueMusic: {fileID: 8300000, guid: 5018ed83599b4ff44a5d9aaa7397792a, type: 3}

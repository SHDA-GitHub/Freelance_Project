  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  dialogueLines:
  - dialogueText: '"Welcome to Samuel Sleazebag''s Emporium."'
    yesDialogueLines: []
    yesChoiceID: yes
    yesButtonText: 
    noDialogueLines: []
    noChoiceID: no
    noButtonText: 
    isChoiceActive: 0
  - dialogueText: '"Whaddaya want, snotnose?"'
    yesDialogueLines:
    - dialogueText: '"Well take a gander at some of my wares, then!"'
      yesDialogueLines: []
      yesChoiceID: 
      yesButtonText: 
      noDialogueLines: []
      noChoiceID: 
      noButtonText: 
      isChoiceActive: 0
    yesChoiceID: buy
    yesButtonText: I'm looking for something
    noDialogueLines:
    - dialogueText: '"Well then get the hell outta my store!"'
      yesDialogueLines: []
      yesChoiceID: 
      yesButtonText: 
      noDialogueLines: []
      noChoiceID: 
      noButtonText: 
      isChoiceActive: 0
    - dialogueText: '"You''re takin'' up my precious business time, ya little runt!"'
      yesDialogueLines: []
      yesChoiceID: 
      yesButtonText: 
      noDialogueLines: []
      noChoiceID: 
      noButtonText: 
      isChoiceActive: 0
    noChoiceID: leave
    noButtonText: Nothing
    isChoiceActive: 1
  dialogueMusic: {fileID: 8300000, guid: 24b0a95a3ef56db4cbf61af98a6283c9, type: 3}

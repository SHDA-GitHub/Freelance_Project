  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  dialogueLines:
  - dialogueText: '"I know who you are."'
    yesDialogueLines: []
    yesButtonText: 
    noDialogueLines: []
    noButtonText: 
    isChoiceActive: 0
  - dialogueText: '"The child of legend..."'
    yesDialogueLines: []
    yesButtonText: 
    noDialogueLines: []
    noButtonText: 
    isChoiceActive: 0
  - dialogueText: '"With his gifted powers and strong emotional resolve."'
    yesDialogueLines: []
    yesButtonText: 
    noDialogueLines: []
    noButtonText: 
    isChoiceActive: 0
  - dialogueText: '"But you cannot stop the Moon Soldiers from taking over your planet."'
    yesDialogueLines: []
    yesButtonText: 
    noDialogueLines: []
    noButtonText: 
    isChoiceActive: 0
  - dialogueText: '"For the glory of the Chorus Beyond!"'

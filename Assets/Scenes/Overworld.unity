--- !u!114 &1348497377
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1348497375}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f91b691bc06f4641996f97a3286f2eb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  dialogueLines:
  - dialogueText: '"My wife thinks I''m being way too hard on my son."'
    yesDialogueLines: []
    yesButtonText: 
    noDialogueLines: []
    noButtonText: 
    isChoiceActive: 0
  - dialogueText: '"It''s only a couple of spakings, a thorough lecture and no allowance
      for a week..."'
    yesDialogueLines: []
    yesButtonText: 
    noDialogueLines: []
    noButtonText: 
    isChoiceActive: 0
  - dialogueText: '"That was because he left the fridge open last night."'
    yesDialogueLines: []
    yesButtonText: 
    noDialogueLines: []
    noButtonText: 
    isChoiceActive: 0
  - dialogueText: '"Do you also think that I''m being too harsh with his punishments?"'
    yesDialogueLines:
    - dialogueText: '"Are you giving me lip, boy?!"'
      yesDialogueLines: []
      yesButtonText: 
      noDialogueLines: []
      noButtonText: 
      isChoiceActive: 0
    - dialogueText: '"I''ll teach you to respect your elders!"'
      yesDialogueLines: []
      yesButtonText: 
      noDialogueLines: []
      noButtonText: 
      isChoiceActive: 0
    yesButtonText: 'Tell him the truth

'
    noDialogueLines:
    - dialogueText: '"Of course I''m not!"'
      yesDialogueLines: []
      yesButtonText: 
      noDialogueLines: []
      noButtonText: 
      isChoiceActive: 0
    - dialogueText: '"I''m his dad, obviously I know what''s best."'
      yesDialogueLines: []
      yesButtonText: 
      noDialogueLines: []
      noButtonText: 
      isChoiceActive: 0
    noButtonText: Lie
    isChoiceActive: 1
  dialogueMusic: {fileID: 0}

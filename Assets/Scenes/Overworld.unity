MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1901963069}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f91b691bc06f4641996f97a3286f2eb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  dialogueLines:
  - dialogueText: '"You sure look strong, kid"'
    yesDialogueLines: []
    yesChoiceID: yes
    yesButtonText: 
    noDialogueLines: []
    noChoiceID: no
    noButtonText: 
    isChoiceActive: 0
  - dialogueText: '"I can tell you''re not just any ordinary person"'
    yesDialogueLines: []
    yesChoiceID: yes
    yesButtonText: 
    noDialogueLines: []
    noChoiceID: no
    noButtonText: 
    isChoiceActive: 0
  - dialogueText: '"You looking to lock horns, man?"'
    yesDialogueLines:
    - dialogueText: '"Then get ready for a tough matchup, little dude."'
      yesDialogueLines: []
      yesChoiceID: 
      yesButtonText: 
      noDialogueLines: []
      noChoiceID: 
      noButtonText: 
      isChoiceActive: 0
    yesChoiceID: yes
    yesButtonText: Sure, I guess?
    noDialogueLines:
    - dialogueText: '"Ah, so you''re a man of peace like me?"'
      yesDialogueLines: []
      yesChoiceID: yes
      yesButtonText: 
      noDialogueLines: []
      noChoiceID: no
      noButtonText: 
      isChoiceActive: 0
    - dialogueText: '"Don''t worry. You can come back whenever you''re prepared"'
      yesDialogueLines: []
      yesChoiceID: yes
      yesButtonText: 
      noDialogueLines: []
      noChoiceID: no
      noButtonText: 
      isChoiceActive: 0
    noChoiceID: no
    noButtonText: Um, no?
    isChoiceActive: 1
  dialogueMusic: {fileID: 8300000, guid: 99270439c839ac643b010dcb21196341, type: 3}

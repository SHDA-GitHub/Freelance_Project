--- !u!114 &1635289085
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1635289083}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2f91b691bc06f4641996f97a3286f2eb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  dialogueLines:
  - dialogueText: '"You really are a pain in the ass, billy!"'
    yesDialogueLines: []
    yesChoiceID: yes
    yesButtonText: 
    noDialogueLines: []
    noChoiceID: no
    noButtonText: 
    isChoiceActive: 0
  - dialogueText: '"Are you really such a little baby that you can''t handle a few
      punches?"'
    yesDialogueLines: []
    yesChoiceID: yes
    yesButtonText: 
    noDialogueLines: []
    noChoiceID: no
    noButtonText: 
    isChoiceActive: 0
  - dialogueText: '"Do you really think you''re stronger than me?"'
    yesDialogueLines:
    - dialogueText: '"And how do you think you''re gonna do that, huh dweeb?"'
      yesDialogueLines: []
      yesChoiceID: 
      yesButtonText: 
      noDialogueLines: []
      noChoiceID: 
      noButtonText: 
      isChoiceActive: 0
    - dialogueText: '"I''m ten times stronger than you!"'
      yesDialogueLines: []
      yesChoiceID: 
      yesButtonText: 
      noDialogueLines: []
      noChoiceID: 
      noButtonText: 
      isChoiceActive: 0
    - dialogueText: '"But if you want to die so badly, I won''t stop you!"'
      yesDialogueLines: []
      yesChoiceID: 
      yesButtonText: 
      noDialogueLines: []
      noChoiceID: 
      noButtonText: 
      isChoiceActive: 0
    yesChoiceID: yes
    yesButtonText: I'm the guy who's going to beat you up
    noDialogueLines:
    - dialogueText: '"Wow, you even admit you''re a loser!"'
      yesDialogueLines: []
      yesChoiceID: 
      yesButtonText: 
      noDialogueLines: []
      noChoiceID: 
      noButtonText: 
      isChoiceActive: 0
    - dialogueText: '"But that won''t make me stop picking on you, small fry!"'
      yesDialogueLines: []
      yesChoiceID: 
      yesButtonText: 
      noDialogueLines: []
      noChoiceID: 
      noButtonText: 
      isChoiceActive: 0
    noChoiceID: no
    noButtonText: I guess not...
    isChoiceActive: 1
  dialogueMusic: {fileID: 8300000, guid: 79633e99eb886a94393f0996a68cc8ee, type: 3}

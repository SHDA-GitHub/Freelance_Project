  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  dialogueLines:
  - dialogueText: '"I know who you are."'
    yesDialogueLines: []
    yesChoiceID: yes
    yesButtonText: 
    noDialogueLines: []
    noChoiceID: no
    noButtonText: 
    isChoiceActive: 0
  - dialogueText: '"The child of legend..."'
    yesDialogueLines: []
    yesChoiceID: yes
    yesButtonText: 
    noDialogueLines: []
    noChoiceID: no
    noButtonText: 
    isChoiceActive: 0
  - dialogueText: '"With his gifted powers and strong emotional resolve."'
    yesDialogueLines: []
    yesChoiceID: yes
    yesButtonText: 
    noDialogueLines: []
    noChoiceID: no
    noButtonText: 
    isChoiceActive: 0
  - dialogueText: '"But you cannot stop the Moon Soldiers from taking over your planet."'
    yesDialogueLines: []
    yesChoiceID: yes
    yesButtonText: 
    noDialogueLines: []
    noChoiceID: no
    noButtonText: 
    isChoiceActive: 0
  - dialogueText: '"For the glory of the Chorus Beyond!"'
    yesDialogueLines: []
    yesChoiceID: yes
    yesButtonText: 
    noDialogueLines: []
    noChoiceID: no
    noButtonText: 
    isChoiceActive: 0
  dialogueMusic: {fileID: 8300000, guid: 352ee1acfa6a77a43a4c37db5a02834f, type: 3}

  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCDialogue
  dialogueLines:
  - dialogueText: '"Bark! Bark!"'
    yesDialogueLines:
    - dialogueText: '"Thanks for the compliment!"'
      yesDialogueLines: []
      yesChoiceID: 
      yesButtonText: 
      noDialogueLines: []
      noChoiceID: 
      noButtonText: 
      isChoiceActive: 0
    - dialogueText: '"But don''t tell anyone else I can talk"'
      yesDialogueLines: []
      yesChoiceID: 
      yesButtonText: 
      noDialogueLines: []
      noChoiceID: 
      noButtonText: 
      isChoiceActive: 0
    - dialogueText: '"I don''t want that kind of attention"'
      yesDialogueLines: []
      yesChoiceID: 
      yesButtonText: 
      noDialogueLines: []
      noChoiceID: 
      noButtonText: 
      isChoiceActive: 0
    yesChoiceID: yes
    yesButtonText: Uhhh, woof?
    noDialogueLines:
    - dialogueText: '*Upset whine*'
      yesDialogueLines: []
      yesChoiceID: 
      yesButtonText: 
      noDialogueLines: []
      noChoiceID: 
      noButtonText: 
      isChoiceActive: 0
    noChoiceID: no
    noButtonText: Shoo, you little mutt!
    isChoiceActive: 1
  dialogueMusic: {fileID: 8300000, guid: 3b83676b619c59a43ad21373945bfe5d, type: 3}

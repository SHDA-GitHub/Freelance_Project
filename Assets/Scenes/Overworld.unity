    - dialogueText: '"Wha? What''s that, sonny?"'
      yesDialogueLines: []
      yesButtonText: 
      noDialogueLines: []
      noButtonText: 
      isChoiceActive: 0
    - dialogueText: '"You''re going on a journey to stop an evil alien overlord from
        destroying the earth?"'
      yesDialogueLines: []
      yesButtonText: 
      noDialogueLines: []
      noButtonText: 
      isChoiceActive: 0
    - dialogueText: '"Heh, kids these days with their wild imaginations!"'
      yesDialogueLines: []
      yesButtonText: 
      noDialogueLines: []
      noButtonText: 
      isChoiceActive: 0
    - dialogueText: '"Well, you have fun out there, kiddo!"'
      yesDialogueLines: []
      yesButtonText: 
      noDialogueLines: []
      noButtonText: 
      isChoiceActive: 0
    yesButtonText: Tell him the truth
    noDialogueLines:
    - dialogueText: '"Wha? What''s that, sonny?"'
      yesDialogueLines: []
      yesButtonText: 
      noDialogueLines: []
      noButtonText: 
      isChoiceActive: 0
    - dialogueText: '"I don''t take too kindly to that type of language!"'
      yesDialogueLines: []
      yesButtonText: 
      noDialogueLines: []
      noButtonText: 
      isChoiceActive: 0
    - dialogueText: '"I may be old, but I''m not stupid!"'
      yesDialogueLines: []
      yesButtonText: 
      noDialogueLines: []
      noButtonText: 
      isChoiceActive: 0
    - dialogueText: '"Err... What was I talking about again?"'
      yesDialogueLines: []
      yesButtonText: 
      noDialogueLines: []
      noButtonText: 
      isChoiceActive: 0
    noButtonText: Be a big stinky meanie
    isChoiceActive: 1
